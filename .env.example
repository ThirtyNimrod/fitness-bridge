# ------------------------------------------------------------------------------
# Fitness Bridge AI - Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file to version control.
# ------------------------------------------------------------------------------

# --- 1. Strava API Configuration ---
# Get these at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here
# Initial refresh token - alternatively use 'python scripts/setup_tokens.py'
STRAVA_REFRESH_TOKEN=

# --- 2. Fitbit API Configuration ---
# Get these at: https://dev.fitbit.com/apps/new (Use "Personal" app type)
FITBIT_CLIENT_ID=your_client_id_here
FITBIT_CLIENT_SECRET=your_client_secret_here
# Initial tokens - alternatively use 'python scripts/setup_tokens.py'
FITBIT_ACCESS_TOKEN=
FITBIT_REFRESH_TOKEN=

# --- 3. AI / LLM Configuration (Ollama) ---
# Ensure Ollama is running: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# --- 4. Database & Persistence ---
DB_PATH=data/fitness_bridge.db
CACHE_DIR=tmp/api_cache

# --- 5. Application Settings ---
# Seconds between background data synchronizations (default: 2 hours)
BACKGROUND_SYNC_INTERVAL=7200
DB_BUSY_TIMEOUT_MS=5000

# ── Upstash Redis (Serverless Token Vault) ───────────────────────────────────
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# --- 6. Analytics & Observability (Optional) ---
# Set these to trace LangGraph agent reasoning in LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=fitness-bridge-ai

# --- 7. Frontend Integration ---
# URL where your FastAPI backend is running
NEXT_PUBLIC_API_URL=http://localhost:8000
